# URL database SQLite/libSQL lokal. Contoh isi: file:.data/maukaga.db
DATABASE_URL=

# Alias database untuk runtime Nuxt server.
NUXT_DATABASE_URL=

# URL root admin/Nitro app untuk server-side runtime.
NUXT_APP_URL=

# URL publik app jika perlu dibaca dari client.
NUXT_PUBLIC_APP_URL=

# Base URL Better Auth. Biasanya sama dengan URL admin/Nitro production.
BETTER_AUTH_URL=

# Daftar origin yang dipercaya Better Auth, dipisahkan koma.
BETTER_AUTH_TRUSTED_ORIGINS=

# Secret production untuk signing/encryption Better Auth.
BETTER_AUTH_SECRET=

# Token untuk membuat admin pertama di production.
ADMIN_BOOTSTRAP_TOKEN=

# URL Google Apps Script Web App untuk Nitro active proxy dan archive sync.
NUXT_APPS_SCRIPT_API_URL=

# URL Google Apps Script Web App yang boleh terekspos ke browser CS static.
NUXT_PUBLIC_APPS_SCRIPT_API_URL=

# Secret HMAC server-to-server untuk Nitro saat memanggil GAS. Isi sama persis dengan Script Property GAS_BRIDGE_SECRET di Apps Script.
NUXT_GAS_BRIDGE_SECRET=

# Alias non-Nuxt untuk secret HMAC yang sama jika runtime lokal membacanya tanpa prefix NUXT_.
GAS_BRIDGE_SECRET=

# Directory lokal tempat Nitro menyimpan file arsip.
NUXT_ARCHIVE_FILE_DIRECTORY=

# Alias non-Nuxt untuk directory lokal file arsip.
ARCHIVE_FILE_DIRECTORY=

# Base path publik untuk file arsip yang diserve dari public/.
NUXT_PUBLIC_ARCHIVE_FILE_BASE_PATH=

# Nama aplikasi yang tampil di UI.
NUXT_PUBLIC_APP_NAME=

# Batas ukuran upload file CS dalam MB.
NUXT_PUBLIC_MAX_UPLOAD_MB=

# Batas jumlah item dalam satu pengajuan CS.
NUXT_PUBLIC_MAX_ITEMS=

# Base URL static app saat dideploy di subfolder.
NUXT_APP_BASE_URL=

# Override versi aplikasi publik.
NUXT_PUBLIC_APP_VERSION=

# Commit hash atau kode revisi build.
NUXT_PUBLIC_APP_REVISION=

# Nama branch build.
NUXT_PUBLIC_APP_BRANCH=

# Timestamp build eksplisit.
NUXT_PUBLIC_APP_BUILD_DATE=

# URL hasil deployment publik.
NUXT_PUBLIC_APP_DEPLOY_URL=
