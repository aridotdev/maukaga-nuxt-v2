{
  "name": "maukaga-nuxt",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "build:admin": "pnpm --filter @maukaga/admin-web build",
    "build:cs": "pnpm sync:cs && pnpm --filter @maukaga/cs-web generate",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "nuxt dev",
    "dev:admin": "pnpm --filter @maukaga/admin-web dev",
    "dev:admin:local": "pnpm --filter @maukaga/admin-web dev:local",
    "dev:cs": "pnpm sync:cs && pnpm --filter @maukaga/cs-web dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "preview:cs": "pnpm --filter @maukaga/cs-web preview",
    "postinstall": "nuxt prepare",
    "sync:admin:local": "pnpm --filter @maukaga/admin-web sync",
    "sync:cs": "node ./scripts/sync-cs-web.mjs",
    "sync:cs:check": "node ./scripts/sync-cs-web.mjs --check",
    "typecheck": "nuxt typecheck",
    "lint": "nuxt prepare && eslint .",
    "lint:fix": "nuxt prepare && eslint . --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.108",
    "@iconify-json/simple-icons": "^1.2.83",
    "@internationalized/date": "^3.12.2",
    "@libsql/client": "^0.17.4",
    "@nuxt/eslint": "1.15.2",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/icon": "^2.5.0",
    "@nuxt/ui": "^4.8.0",
    "@nuxtjs/supabase": "^2.0.9",
    "@tanstack/table-core": "^8.21.3",
    "@unovis/ts": "^1.6.5",
    "@unovis/vue": "^1.6.5",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "date-fns": "^4.2.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "nuxt": "^4.4.6",
    "scule": "^1.3.0",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.4.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.0"
  }
}
